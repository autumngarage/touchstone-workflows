# Source this file from a private supervisor configuration after replacing
# every placeholder. Never store the registration token in this file.
export RELEASE_RUNNER_ORG=autumngarage
export RELEASE_RUNNER_GROUP=macos-release
export RELEASE_RUNNER_LABEL=macos-release
export RELEASE_RUNNER_TOKEN_FILE=/private/runner-registration-token
export RELEASE_RUNNER_STATE=/private/release-runner-state
export RELEASE_RUNNER_IMAGE=ghcr.io/OWNER/IMAGE@sha256:REPLACE_WITH_REVIEWED_DIGEST
export RELEASE_RUNNER_TART=/absolute/path/to/tart
export RELEASE_RUNNER_BOOT_SECONDS=300
export RELEASE_RUNNER_JOB_SECONDS=7200
# PATH must contain the reviewed Softnet helper, gh, jq, and standard tools.
